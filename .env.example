# Core app
DOMAIN=<your_app_domain>
TOKEN_SECRET=<your_token_secret>
MONGODB_URI=<your_database_uri>
ALLOWED_ORIGINS=localhost:3000

# Email delivery
RESEND_API_KEY=<your_resend_api_key>
MAIL_FROM=no-reply@<your_domain>

# AI / embedding services
GEMINI_API_KEY=<your_gemini_api_key>
HUGGINGFACE_API_KEY=<your_huggingface_api_key>
HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Rate limiting (optional but STRONGLY recommended on Vercel).
# Without these, rate limiting falls back to per-instance in-memory counters
# that reset on every cold start and don't work across serverless instances.
# Create a free Redis database at https://upstash.com and paste the REST creds.
UPSTASH_REDIS_REST_URL=<your_upstash_redis_rest_url>
UPSTASH_REDIS_REST_TOKEN=<your_upstash_redis_rest_token>

# Local development
NODE_ENV=development
PORT=3000